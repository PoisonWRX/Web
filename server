'use strict';
// Sitio de tutoriales: cuentas, subida de archivos sin límite y panel de administración.
// Sin dependencias externas. Requiere Node 22.13+.
const http = require('node:http');
const fs = require('node:fs');
const path = require('node:path');
const crypto = require('node:crypto');
const { pipeline } = require('node:stream/promises');
const { DatabaseSync } = require('node:sqlite');

const PORT = +process.env.PORT || 3000;
const DATA_DIR = path.resolve(process.env.DATA_DIR || path.join(__dirname, 'data'));
const UPLOAD_DIR = path.join(DATA_DIR, 'uploads');
fs.mkdirSync(UPLOAD_DIR, { recursive: true });

const db = new DatabaseSync(path.join(DATA_DIR, 'site.db'));
db.exec(`
PRAGMA journal_mode=WAL;
CREATE TABLE IF NOT EXISTS users(id INTEGER PRIMARY KEY, username TEXT UNIQUE COLLATE NOCASE, pass TEXT, role TEXT DEFAULT 'user', created INTEGER);
CREATE TABLE IF NOT EXISTS sessions(token TEXT PRIMARY KEY, user_id INTEGER, expires INTEGER);
CREATE TABLE IF NOT EXISTS settings(key TEXT PRIMARY KEY, value TEXT);
CREATE TABLE IF NOT EXISTS tutorials(id INTEGER PRIMARY KEY, title TEXT, summary TEXT, body TEXT, published INTEGER DEFAULT 1, created INTEGER, updated INTEGER);
CREATE TABLE IF NOT EXISTS files(id INTEGER PRIMARY KEY, tutorial_id INTEGER, name TEXT, stored TEXT, size INTEGER, mime TEXT, created INTEGER);
`);

// ---------- ajustes editables ----------
const DEFAULTS = {
  site_name: 'Mis Tutoriales',
  tagline: 'Aprende paso a paso',
  intro: 'Bienvenido. Aquí encontrarás tutoriales básicos con sus archivos para descargar.',
  accent: '#2563eb',
  footer: '© Mis Tutoriales',
  allow_registration: '1',
  require_login_download: '0',
};
const getSettings = () => {
  const s = { ...DEFAULTS };
  for (const r of db.prepare('SELECT key,value FROM settings').all()) s[r.key] = r.value;
  return s;
};
const setSetting = (k, v) => db.prepare('INSERT INTO settings(key,value) VALUES(?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value').run(k, String(v));

// ---------- contraseñas / sesiones ----------
const hashPass = (p) => { const salt = crypto.randomBytes(16).toString('hex'); return salt + ':' + crypto.scryptSync(p, salt, 64).toString('hex'); };
const checkPass = (p, stored) => {
  const [salt, h] = String(stored).split(':');
  if (!salt || !h) return false;
  const a = Buffer.from(h, 'hex'), b = crypto.scryptSync(p, salt, 64);
  return a.length === b.length && crypto.timingSafeEqual(a, b);
};
const DAY = 86400000;
function newSession(userId) {
  const token = crypto.randomBytes(32).toString('hex');
  db.prepare('INSERT INTO sessions VALUES(?,?,?)').run(token, userId, Date.now() + 30 * DAY);
  return token;
}
db.prepare('DELETE FROM sessions WHERE expires<?').run(Date.now());

// Administrador inicial
if (!db.prepare("SELECT 1 FROM users WHERE role='admin'").get()) {
  const user = process.env.ADMIN_USER || 'admin';
  let pass = process.env.ADMIN_PASS;
  let generated = false;
  if (!pass) { pass = crypto.randomBytes(9).toString('base64url'); generated = true; }
  db.prepare("INSERT INTO users(username,pass,role,created) VALUES(?,?,'admin',?)").run(user, hashPass(pass), Date.now());
  if (generated) {
    fs.writeFileSync(path.join(DATA_DIR, 'admin-credentials.txt'), `usuario: ${user}\ncontraseña: ${pass}\n`, { mode: 0o600 });
    console.log(`\n>>> Administrador creado. Usuario: ${user}  Contraseña: ${pass}\n    (guardado en ${path.join(DATA_DIR, 'admin-credentials.txt')}; bórralo tras anotarla)\n`);
  } else console.log(`Administrador creado: ${user}`);
}

// ---------- utilidades ----------
const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const fmtSize = (n) => { const u = ['B', 'KB', 'MB', 'GB', 'TB']; let i = 0; n = +n; while (n >= 1024 && i < 4) { n /= 1024; i++; } return (i ? n.toFixed(1) : n) + ' ' + u[i]; };
const fmtDate = (t) => new Date(t).toLocaleDateString('es-CL');

const MIME = {
  png: 'image/png', jpg: 'image/jpeg', jpeg: 'image/jpeg', gif: 'image/gif', webp: 'image/webp', avif: 'image/avif',
  mp4: 'video/mp4', webm: 'video/webm', mov: 'video/quicktime', mkv: 'video/x-matroska', m4v: 'video/mp4',
  mp3: 'audio/mpeg', wav: 'audio/wav', ogg: 'audio/ogg', m4a: 'audio/mp4', flac: 'audio/flac', aac: 'audio/aac',
  pdf: 'application/pdf', apk: 'application/vnd.android.package-archive', zip: 'application/zip',
  txt: 'text/plain', json: 'application/json',
};
const mimeOf = (name) => MIME[path.extname(name).slice(1).toLowerCase()] || 'application/octet-stream';
// Solo estos tipos se muestran "inline"; el resto siempre se descarga (evita ejecutar HTML/SVG subido).
const INLINE = /^(image\/(png|jpeg|gif|webp|avif)|video\/(mp4|webm|quicktime)|audio\/|application\/pdf)/;

function renderBody(text) {
  const blocks = String(text || '').replace(/\r/g, '').split(/\n{2,}/);
  const link = (s) => s.replace(/(https?:\/\/[^\s<]+)/g, '<a href="$1" target="_blank" rel="noopener noreferrer">$1</a>');
  return blocks.map((b) => {
    b = b.trim(); if (!b) return '';
    if (b.startsWith('```')) return '<pre><code>' + esc(b.replace(/^```.*\n?/, '').replace(/```$/, '')) + '</code></pre>';
    if (/^#{1,3} /.test(b)) return '<h2>' + esc(b.replace(/^#{1,3} /, '')) + '</h2>';
    const lines = b.split('\n');
    if (lines.every((l) => /^(- |\d+\. )/.test(l))) {
      const tag = /^\d+\./.test(lines[0]) ? 'ol' : 'ul';
      return `<${tag}>` + lines.map((l) => '<li>' + link(esc(l.replace(/^(- |\d+\. )/, ''))) + '</li>').join('') + `</${tag}>`;
    }
    return '<p>' + link(esc(b)).replace(/\n/g, '<br>') + '</p>';
  }).join('\n');
}

