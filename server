// ---------- helpers HTTP ----------
const send = (res, code, body, type = 'text/html; charset=utf-8', extra = {}) => {
  res.writeHead(code, { 'Content-Type': type, 'X-Content-Type-Options': 'nosniff', 'Referrer-Policy': 'same-origin', ...extra });
  res.end(body);
};
const redirect = (res, to, extra = {}) => { res.writeHead(303, { Location: to, ...extra }); res.end(); };
const flash = (to, m) => to + (to.includes('?') ? '&' : '?') + 'msg=' + encodeURIComponent(m);
const parseCookies = (h) => Object.fromEntries(String(h || '').split(';').map((c) => c.trim().split('=')).filter((x) => x[0]).map(([k, ...v]) => [k, v.join('=')]));
function readForm(req, limit = 4 * 1024 * 1024) {
  return new Promise((resolve, reject) => {
    let size = 0; const chunks = [];
    req.on('data', (c) => { size += c.length; if (size > limit) { reject(new Error('too big')); req.destroy(); } else chunks.push(c); });
    req.on('end', () => resolve(Object.fromEntries(new URLSearchParams(Buffer.concat(chunks).toString()))));
    req.on('error', reject);
  });
}
const cookieFlags = (req) => 'Path=/; HttpOnly; SameSite=Lax' + (req.headers['x-forwarded-proto'] === 'https' ? '; Secure' : '');

// freno simple contra fuerza bruta
const fails = new Map();
const ipOf = (req) => (req.headers['x-forwarded-for'] || req.socket.remoteAddress || '').split(',')[0].trim();
const blocked = (ip) => { const f = fails.get(ip); return f && f.n >= 10 && Date.now() - f.t < 10 * 60000; };
const fail = (ip) => { const f = fails.get(ip); fails.set(ip, { n: (f && Date.now() - f.t < 10 * 60000 ? f.n : 0) + 1, t: Date.now() }); };

// ---------- páginas ----------
const pages = {};

pages.home = (req, res) => {
  const s = getSettings();
  const list = db.prepare('SELECT * FROM tutorials WHERE published=1 ORDER BY created DESC').all();
  send(res, 200, layout(req, 'Inicio', `<h1>${esc(s.tagline)}</h1><p class="muted">${esc(s.intro)}</p>` +
    (list.length ? list.map((t) => `<div class="card"><h3><a href="/t/${t.id}">${esc(t.title)}</a></h3><div class="muted">${esc(t.summary)}</div><small class="muted">${fmtDate(t.created)}</small></div>`).join('') : '<div class="card muted">Aún no hay tutoriales.</div>'),
    { msg: req.q.get('msg') }));
};

pages.tutorial = (req, res, id) => {
  const t = db.prepare('SELECT * FROM tutorials WHERE id=?').get(id);
  if (!t || (!t.published && req.user?.role !== 'admin')) return send(res, 404, layout(req, 'No encontrado', '<h1>No encontrado</h1>'));
  const s = getSettings();
  const canGet = s.require_login_download !== '1' || req.user;
  const files = db.prepare('SELECT * FROM files WHERE tutorial_id=? ORDER BY id').all(id);
  let fhtml = '';
  if (files.length) {
    fhtml = '<h2>Archivos</h2>' + (canGet ? '' : '<div class="card muted">Debes <a href="/login">iniciar sesión</a> o <a href="/registro">crear una cuenta</a> para ver y descargar los archivos.</div>');
    if (canGet) fhtml += files.map((f) => {
      const url = `/f/${f.id}`; let media = '';
      if (f.mime.startsWith('image/') && INLINE.test(f.mime)) media = `<img class="m" src="${url}" alt="${esc(f.name)}" loading="lazy">`;
      else if (f.mime.startsWith('video/') && INLINE.test(f.mime)) media = `<video class="m" controls preload="metadata" src="${url}"></video>`;
      else if (f.mime.startsWith('audio/')) media = `<audio controls preload="metadata" src="${url}"></audio>`;
      return `<div class="card">${media}<div class="file"><span>📎 ${esc(f.name)} <small class="muted">(${fmtSize(f.size)})</small></span><a class="btn sec" href="${url}?dl=1">Descargar</a></div></div>`;
    }).join('');
  }
  send(res, 200, layout(req, t.title, `<h1>${esc(t.title)}</h1><p class="muted">${esc(t.summary)}${t.published ? '' : ' · <b>(borrador)</b>'}</p>${renderBody(t.body)}${fhtml}
${req.user?.role === 'admin' ? `<p><a class="btn sec" href="/admin/t/${t.id}">Editar</a></p>` : ''}`));
};

pages.file = (req, res, id) => {
  const f = db.prepare('SELECT * FROM files WHERE id=?').get(id);
  if (!f) return send(res, 404, 'No encontrado', 'text/plain');
  if (getSettings().require_login_download === '1' && !req.user) return redirect(res, flash('/login', 'Inicia sesión para descargar'));
  const p = path.join(UPLOAD_DIR, f.stored);
  let size; try { size = fs.statSync(p).size; } catch { return send(res, 404, 'Archivo no disponible', 'text/plain'); }
  const dl = req.q.get('dl') === '1' || !INLINE.test(f.mime);
  const headers = {
    'Content-Type': INLINE.test(f.mime) ? f.mime : 'application/octet-stream',
    'Accept-Ranges': 'bytes', 'X-Content-Type-Options': 'nosniff',
    'Content-Disposition': `${dl ? 'attachment' : 'inline'}; filename*=UTF-8''${encodeURIComponent(f.name)}`,
    'Content-Security-Policy': "sandbox; default-src 'none'",
  };
  if (f.mime === 'application/vnd.android.package-archive') headers['Content-Type'] = f.mime;
  let start = 0, end = size - 1, code = 200;
  const m = size && /^bytes=(\d*)-(\d*)$/.exec(req.headers.range || '');
  if (m && (m[1] || m[2])) {
    if (!m[1]) start = Math.max(size - +m[2], 0); else { start = +m[1]; if (m[2]) end = Math.min(+m[2], size - 1); }
    if (start > end || start >= size) { res.writeHead(416, { 'Content-Range': `bytes */${size}` }); return res.end(); }
    code = 206; headers['Content-Range'] = `bytes ${start}-${end}/${size}`;
  }
  headers['Content-Length'] = size ? end - start + 1 : 0;
  res.writeHead(code, headers);
  if (!size || req.method === 'HEAD') return res.end();
  fs.createReadStream(p, { start, end }).on('error', () => res.destroy()).pipe(res);
};

pages.registro = async (req, res) => {
  const s = getSettings();
  if (s.allow_registration !== '1') return send(res, 403, layout(req, 'Registro', '<h1>Registro cerrado</h1>'));
  let err = '';
  if (req.method === 'POST') {
    const f = await readForm(req);
    const username = (f.username || '').trim();
    if (!/^[a-zA-Z0-9_.-]{3,30}$/.test(username)) err = 'Usuario: 3–30 caracteres (letras, números, _ . -).';
    else if ((f.password || '').length < 8) err = 'La contraseña debe tener al menos 8 caracteres.';
    else if (f.password !== f.password2) err = 'Las contraseñas no coinciden.';
    else if (db.prepare('SELECT 1 FROM users WHERE username=?').get(username)) err = 'Ese usuario ya existe.';
    else {
      const r = db.prepare("INSERT INTO users(username,pass,role,created) VALUES(?,?,'user',?)").run(username, hashPass(f.password), Date.now());
      const tok = newSession(+r.lastInsertRowid);
      return redirect(res, flash('/', '¡Cuenta creada!'), { 'Set-Cookie': `sid=${tok}; Max-Age=${30 * 86400}; ${cookieFlags(req)}` });
    }
  }
  send(res, 200, layout(req, 'Registro', `<h1>Crear cuenta</h1><form method="post" class="card">
<label>Usuario</label><input type="text" name="username" required autocomplete="username">
<label>Contraseña (mín. 8)</label><input type="password" name="password" required autocomplete="new-password">
<label>Repetir contraseña</label><input type="password" name="password2" required autocomplete="new-password">
<p><button class="btn">Registrarme</button></p></form>`, { msg: err }));
};

pages.login = async (req, res) => {
  let err = '';
  if (req.method === 'POST') {
    const ip = ipOf(req);
    if (blocked(ip)) err = 'Demasiados intentos. Espera 10 minutos.';
    else {
      const f = await readForm(req);
      const u = db.prepare('SELECT * FROM users WHERE username=?').get((f.username || '').trim());
      if (u && checkPass(f.password || '', u.pass)) {
        fails.delete(ip);
        return redirect(res, u.role === 'admin' ? '/admin' : '/', { 'Set-Cookie': `sid=${newSession(u.id)}; Max-Age=${30 * 86400}; ${cookieFlags(req)}` });
      }
      fail(ip); err = 'Usuario o contraseña incorrectos.';
    }
  }
  send(res, 200, layout(req, 'Entrar', `<h1>Entrar</h1><form method="post" class="card">
<label>Usuario</label><input type="text" name="username" required autocomplete="username">
<label>Contraseña</label><input type="password" name="password" required autocomplete="current-password">
<p><button class="btn">Entrar</button></p></form>`, { msg: err || req.q.get('msg') }));
};

pages.logout = (req, res) => {
  const tok = parseCookies(req.headers.cookie).sid;
  if (tok) db.prepare('DELETE FROM sessions WHERE token=?').run(tok);
  redirect(res, '/', { 'Set-Cookie': `sid=; Max-Age=0; ${cookieFlags(req)}` });
};

pages.cuenta = async (req, res) => {
  if (!req.user) return redirect(res, '/login');
  let msg = req.q.get('msg') || '';
  if (req.method === 'POST') {
    const f = await readForm(req);
    if (!checkPass(f.old || '', req.user.pass)) msg = 'La contraseña actual no es correcta.';
    else if ((f.password || '').length < 8) msg = 'La nueva contraseña debe tener al menos 8 caracteres.';
    else {
      db.prepare('UPDATE users SET pass=? WHERE id=?').run(hashPass(f.password), req.user.id);
      db.prepare('DELETE FROM sessions WHERE user_id=? AND token<>?').run(req.user.id, parseCookies(req.headers.cookie).sid);
      msg = 'Contraseña actualizada.';
    }
  }
  send(res, 200, layout(req, 'Mi cuenta', `<h1>Mi cuenta</h1><p class="muted">Usuario: ${esc(req.user.username)} · Rol: ${req.user.role}</p>
<form method="post" class="card"><h3>Cambiar contraseña</h3>
<label>Contraseña actual</label><input type="password" name="old" required>
<label>Nueva contraseña</label><input type="password" name="password" required autocomplete="new-password">
<p><button class="btn">Guardar</button></p></form>`, { msg }));
};

// ---------- administración ----------
const requireAdmin = (req, res) => {
  if (req.user?.role === 'admin') return true;
  if (req.user) send(res, 403, layout(req, 'Prohibido', '<h1>Solo administradores</h1>')); else redirect(res, '/login');
  return false;
};

